// Lets the photobooth app (runs as admin) end the boot splash when it's ready to draw.
// Only starting that one service is allowed.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "snapbox-splash-quit.service" &&
        action.lookup("verb") == "start" &&
        subject.user == "admin") {
        return polkit.Result.YES;
    }
});
